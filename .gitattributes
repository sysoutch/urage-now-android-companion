# Keep generated and binary Android artefacts out of text diffs.
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.glb binary
*.fbx binary
# Gradle wrapper is a required binary bootstrap dependency.
gradle/wrapper/gradle-wrapper.jar binary
# Normalize source files regardless of the developer's platform.
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
app/libs/matrix-sdk-android-tls-init.aar filter=lfs diff=lfs merge=lfs -text
